# JobPilot configuration. Copy to .env and fill in locally. NEVER commit .env.
# Variable names only — no real values here.

# --- core ---
JOBPILOT_ENV=development            # development | production
JOBPILOT_PASSWORD=                  # access password; REQUIRED in production (choose a long random one)
JOBPILOT_SECRET_KEY=                # random string for signing sessions; REQUIRED in production
JOBPILOT_DATA_DIR=                  # optional; defaults to ./data
JOBPILOT_PERSISTENT_STORAGE=        # 1 if the data dir survives restarts (EC2 volume / Render disk)
JOBPILOT_COOKIE_SECURE=             # default: on in production (needs HTTPS)
JOBPILOT_SCHEDULER=1                # daily discovery on/off
JOBPILOT_DISCOVERY_HOUR=7           # local hour for daily discovery
PUBLIC_HOST=                        # EC2/docker-compose only, e.g. 13-233-10-20.sslip.io

# --- accounts & admin ---
OWNER_SETUP_TOKEN=                  # one-time secret for /setup-owner (creates the owner account)

# --- optional: Google sign-in (OAuth client: Web application) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                # optional; default https://<host>/api/auth/google/callback

# --- optional: transactional email (verification, password reset, trial reminders) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- backups (S3-compatible: Cloudflare R2 or Amazon S3). Without these, backups go to a local folder ---
BACKUP_S3_ENDPOINT=                 # e.g. https://<account-id>.r2.cloudflarestorage.com or https://s3.ap-south-1.amazonaws.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto               # "auto" for R2; the bucket region for S3
BACKUP_ENCRYPTION_KEY=              # long random string; REQUIRED for cloud backups; keep a copy offline
BACKUP_LOCAL_DIR=                   # optional local backup folder

# --- payments: intentionally NOT configured (disabled until explicitly approved) ---

# --- optional AI (free tiers preferred; JobPilot works fully without AI) ---
AI_PROVIDER=none                    # none | gemini | groq | openai_compatible
GEMINI_API_KEY=
GROQ_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_PRICE_INPUT_INR_PER_M=0          # for budget tracking; 0 on free tiers
AI_PRICE_OUTPUT_INR_PER_M=0
