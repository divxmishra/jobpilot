# JobPilot configuration. Copy to .env and fill in locally. NEVER commit .env.
# Variable names only — no real values here.

# --- core ---
JOBPILOT_ENV=development            # development | production
JOBPILOT_PASSWORD=                  # access password; REQUIRED in production (choose a long random one)
JOBPILOT_SECRET_KEY=                # random string for signing sessions; REQUIRED in production
JOBPILOT_DATA_DIR=                  # optional; defaults to ./data
JOBPILOT_PERSISTENT_STORAGE=        # 1 if the data dir survives restarts (EC2 volume / Render disk)
JOBPILOT_COOKIE_SECURE=             # default: on in production (needs HTTPS)
JOBPILOT_SCHEDULER=1                # daily discovery on/off
JOBPILOT_DISCOVERY_HOUR=7           # local hour for daily discovery
PUBLIC_HOST=                        # EC2/docker-compose only, e.g. 13-233-10-20.sslip.io

# --- optional AI (free tiers preferred; JobPilot works fully without AI) ---
AI_PROVIDER=none                    # none | gemini | groq | openai_compatible
GEMINI_API_KEY=
GROQ_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_PRICE_INPUT_INR_PER_M=0          # for budget tracking; 0 on free tiers
AI_PRICE_OUTPUT_INR_PER_M=0
